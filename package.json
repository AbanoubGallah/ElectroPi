{
  "name": "electropi-pos-automation",
  "version": "1.0.0",
  "private": true,
  "description": "UI + API test automation framework for the Electro Pi multi-tenant POS & Inventory platform",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "app": "node mock-app/server.js",
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "test:debug": "PWDEBUG=1 playwright test --project=ui-chromium",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "postman:api": "newman run postman/ElectroPi-POS.postman_collection.json -e postman/ElectroPi-Local.postman_environment.json --reporters cli,junit --reporter-junit-export reports/newman-junit.xml",
    "pdf": "python3 docs/build-pdf.py && node docs/build-pdf.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
