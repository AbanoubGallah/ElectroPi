# Copy to .env and adjust per environment. CI injects these as secrets/variables.
BASE_URL=http://127.0.0.1:4173
API_BASE_URL=http://127.0.0.1:4173/api/v1

# Tenant under test (the platform is multi-tenant, every run is tenant-scoped)
TENANT_ID=tenant-alpha

# Store Admin - can create inventory items
STORE_ADMIN_EMAIL=admin@alpha-store.io
STORE_ADMIN_PASSWORD=Passw0rd!

# Cashier - read-only on inventory, used for the 403 negative test
CASHIER_EMAIL=cashier@alpha-store.io
CASHIER_PASSWORD=Passw0rd!

# Admin of a second merchant - proves tenant isolation (404 on cross-tenant reads)
OTHER_TENANT_ADMIN_EMAIL=admin@beta-store.io
OTHER_TENANT_ADMIN_PASSWORD=Passw0rd!
